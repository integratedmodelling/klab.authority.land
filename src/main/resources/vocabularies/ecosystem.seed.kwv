/** Invented prototype configurations and identities for ecosystem assessment. */
ontology ecosystem.seed
    "Ecosystem characterization prototypes; consistency and quantitative interpretations need review."
    version 0.1
    using imod, physical, landcover.seed
    in domain imod:Knowledge of (imod:Geosphere or imod:Biosphere);

identity EcosystemClass;
identity Characteristic;
configuration Biogeography is imod:Configuration;
configuration BioticTraits is imod:Configuration;
configuration Climate is imod:Configuration;
configuration Connectivity is imod:Configuration;
configuration Disturbance is imod:Configuration;
configuration Ecosystem is imod:Configuration;
configuration EnergyRegime is imod:Configuration;
configuration Environment is imod:Configuration;
configuration Hydrodynamics is imod:Configuration;
configuration Hydrology is imod:Configuration;
configuration HydroperiodCycle is imod:Configuration;
configuration Landform is imod:Configuration;
configuration Management is imod:Configuration;
configuration Morphology is imod:Configuration;
configuration Phenology is imod:Configuration;
configuration Substrate is imod:Configuration;
configuration TemporalSuccession is imod:Configuration;
configuration TrophicRegime is imod:Configuration;
configuration WaterChemistry is imod:Configuration;
configuration WaterColumn is imod:Configuration;
